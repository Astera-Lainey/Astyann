import { ChangeDetectionStrategy, Component, CUSTOM_ELEMENTS_SCHEMA, inject } from '@angular/core';
import { CommonModule } from '@angular/common';
import { Router, RouterLink, RouterLinkActive } from '@angular/router';
// Side-effect import: registers the <iconify-icon> custom element with the browser.
import 'iconify-icon';

interface NavItem {
  label: string;
  path: string;
  icon: string;
  roles: string[];
}

@Component({
  selector: 'app-sidebar',
  standalone: true,
  imports: [CommonModule, RouterLink, RouterLinkActive],
  templateUrl: './sidebar.component.html',
  changeDetection: ChangeDetectionStrategy.OnPush,
  // <iconify-icon> is a web component, not an Angular one — without this schema the template
  // compiler rejects it as an unknown element and `ng build` fails.
  schemas: [CUSTOM_ELEMENTS_SCHEMA]
})
export class SidebarComponent {

  private readonly router = inject(Router);

  readonly navItems: NavItem[] = [
{{#navigation}}
    { label: '{{label}}', path: '{{path}}', icon: '{{icon}}', roles: [{{#roles}}'{{.}}', {{/roles}}] },
{{/navigation}}
  ];

  logout(): void {
    localStorage.removeItem('token');
    this.router.navigateByUrl('/login');
  }
}
