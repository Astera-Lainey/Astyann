' ============================================================
' client (outbound Feign clients)
' ============================================================
package "client" {
  interface AIServiceClient {
    +analyzeProjectInformation(projectId : UUID, document : MultipartFile) : ProjectAnalysisResponseDTO
    +mergeDocumentAndAnswers(projectId : UUID, body : MergeRequestBody) : ProjectAnalysisResponseDTO
    +infer(body : InferBody) : InferenceResponseDTO
  }

  note bottom of AIServiceClient
    @FeignClient("ai-service", url="${services.ai.url}").
    infer() is used for all three INF-1/3/4 passes with a
    different model/system-prompt/user-prompt per call.
  end note

  interface RAGServiceClient {
    +indexDocument(item : RagIndexItemDTO) : void
    +indexBatch(batch : RagBatchIndexDTO) : void
  }

  note bottom of RAGServiceClient
    @FeignClient("rag-service", url="${services.rag.url}").
    See RAG service.puml for the receiving side.
  end note
}

' ============================================================
' repository
' ============================================================
package "repository" {
  interface RequirementRepository {
    +findByProjectId(projectId : UUID) : Optional<Requirement>
    +existsByProjectId(projectId : UUID) : boolean
  }

  interface ClarificationQuestionRepository {
    +findByRequirementOrderByPriorityAsc(requirement : Requirement) : List<ClarificationQuestion>
    +findByRequirement_RequirementIdOrderByPriorityAsc(requirementId : UUID) : List<ClarificationQuestion>
    +findByRequirement_RequirementIdAndAnsweredFalseOrderByPriorityAsc(requirementId : UUID) : List<ClarificationQuestion>
    +countByRequirement_RequirementIdAndAnsweredFalse(requirementId : UUID) : int
    +deleteByRequirement(requirement : Requirement) : void
  }
}

' ============================================================
' exception
' ============================================================
package "exception" {
  class RequirementNotFoundException {
    +RequirementNotFoundException(projectId : UUID)
  }

  class GlobalExceptionHandler {
    +handleNotFound(ex : RequirementNotFoundException) : ResponseEntity<Map<String,String>>
    +handleIllegalState(ex : IllegalStateException) : ResponseEntity<Map<String,String>>
    +handleGeneric(ex : Exception) : ResponseEntity<Map<String,String>>
  }

  note bottom of GlobalExceptionHandler
    RequirementNotFoundException -> 404
    IllegalStateException -> 409 (e.g. retry called on a
    non-FAILED requirement, or on one whose PCSF was never
    created)
    Exception -> 500
  end note
}

