@startuml
title Astyann - Requirement Service Design Class Diagram

left to right direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

' ============================================================
' controller
' ============================================================
package "controller" {
  class RequirementController {
    -requirementRepository : RequirementRepository
    -backgroundService : RequirementBackgroundService
    -generationService : RequirementGenerationService
    -qaService : QAService
    -validationService : PcsfValidationService
    -fieldWriter : PcsfFieldWriter
    +initialize(projectId : String, body : RequirementInitRequest) : ResponseEntity<ApiResponse<Void>>
    +getQuestions(projectId : String) : ResponseEntity<ApiResponse<List<ClarificationQuestionDto>>>
    +submitAnswers(projectId : String, request : SubmitAnswersRequest) : ResponseEntity<ApiResponse<QAResponse>>
    +getPcsf(projectId : String) : ResponseEntity<ApiResponse<Pcsf>>
    +patchField(projectId : String, request : PatchFieldRequest) : ResponseEntity<ApiResponse<Void>>
    +getPcsfStatus(projectId : String) : ResponseEntity<ApiResponse<PcsfStatusResponse>>
    +validatePcsf(projectId : String) : ResponseEntity<ApiResponse<PcsfValidateResponse>>
    +approve(projectId : String) : ResponseEntity<ApiResponse<ApproveResponse>>
    +changeRequest(projectId : String, body : ChangeRequestBody) : ResponseEntity<ApiResponse<ChangeRequestResponse>>
    +regenerate(projectId : String) : ResponseEntity<ApiResponse<Void>>
    +retry(projectId : String) : ResponseEntity<ApiResponse<Void>>
    +downloadTemplate() : ResponseEntity<byte[]>
  }
}

' ============================================================
' service (top-level orchestration)
' ============================================================
package "service" {
  class RequirementBackgroundService {
    +initializePipelineAsync(projectId : UUID, projectTitle : String, projectDescription : String, projectContext : String, documentText : String) : void
  }

  note bottom of RequirementBackgroundService
    @Async entry point called by ProjectService right after
    project creation. Creates the Requirement row, then runs
    PcsfInitialiserService + DocumentExtractionService.
    On failure, sets pcsfStatus = FAILED. documentText is a
    method parameter only — it is NOT persisted, so a failure
    at this stage cannot currently be retried (see /retry note).
  end note

  class RequirementGenerationService {
    -inferenceService : AiInferencePcsfService
    -ragIndexingService : RagIndexingService
    +approve(projectId : UUID) : ApproveResponse
    +submitChangeRequest(projectId : UUID, instructions : String) : ChangeRequestResponse
    +regenerate(projectId : UUID) : void
    +retryInference(projectId : UUID) : void
  }

  note bottom of RequirementGenerationService
    retryInference() only covers inference-stage (INF-1/3/4)
    failures: it requires pcsfJson to already exist and
    pcsfStatus == FAILED, and re-dispatches runReInferenceAsync
    (if changeInstructions is still set) or runInferenceAsync
    otherwise. The async dispatch is deferred via
    TransactionSynchronizationManager.afterCommit(), same
    pattern as PcsfCompletenessAnalyser's inference trigger,
    to avoid the async worker reading pre-commit stale state.
  end note

  class RagIndexingService {
    +initializeIndexAsync(requirementId : UUID) : void
    -buildChunks(req : Requirement, pcsf : Pcsf) : List<RagIndexItemDTO>
    -buildProjectOverview(req : Requirement, pcsf : Pcsf) : Object
    -addItem(items : List<RagIndexItemDTO>, projectId : UUID, requirementId : UUID, section : String, extraMeta : Map<String,String>, payload : Object) : void
  }

  note bottom of RagIndexingService
    Triggered after approve(), deferred until afterCommit.
    Splits the approved PCSF into one chunk per section
    (project overview, actors, modules, entities,
    relationships, business rules, status machines,
    access control, error codes, endpoints, NFRs, UI
    screens/navigation/colours, infrastructure) and pushes
    them via RAGServiceClient.indexBatch(). Failure is
    swallowed (graceful degradation) — never blocks approval;
    recoverable via POST /api/v1/rag/{projectId}/rebuild.
  end note
}

' ============================================================
' service.pcsf (PCSF pipeline)
' ============================================================
package "service.pcsf" {
  class PcsfInitialiserService {
    +initialise(requirement : Requirement) : void
    -buildDerivedNames(name : String) : PcsfDerivedNames
    -buildDefaultNfr() : PcsfNonFunctionalRequirements
  }

  class DocumentExtractionService {
    -aiServiceClient : AIServiceClient
    -completenessAnalyser : PcsfCompletenessAnalyser
    +extract(requirement : Requirement, documentText : String) : void
    -buildExtractionPrompt(documentText : String) : String
    -applyExtractionResult(requirement : Requirement, rawContent : String) : void
  }

  class QAService {
    -fieldWriter : PcsfFieldWriter
    -completenessAnalyser : PcsfCompletenessAnalyser
    +submitAnswers(projectId : UUID, request : SubmitAnswersRequest) : QAResponse
    +getPendingQuestions(projectId : UUID) : List<ClarificationQuestion>
  }

  class PcsfCompletenessAnalyser {
    -questionGenerator : QuestionGeneratorService
    -inferenceService : AiInferencePcsfService
    +analyse(requirement : Requirement) : ValidationResult
    -checkMandatory(pcsf : Pcsf, missing : List<String>) : void
    -scanConditionals(text : String, pcsf : Pcsf, pending : List<String>) : void
    -checkCrossReferences(pcsf : Pcsf, errors : List<String>) : void
    -computeScore(pcsf : Pcsf, missing : List<String>) : double
  }

  note bottom of PcsfCompletenessAnalyser
    "Gate-1": if mandatory fields are missing or a conditional
    feature keyword is detected (upload/export/search/
    multi-tenancy) without a confirmed answer, delegates to
    QuestionGeneratorService. Otherwise triggers AI inference,
    deferred until afterCommit to avoid stale-read races.
  end note

  class QuestionGeneratorService {
    +generateQuestions(requirement : Requirement, pcsf : Pcsf, missing : List<String>, conditionalPending : List<String>) : void
  }

  class AiInferencePcsfService {
    -aiServiceClient : AIServiceClient
    +runInferenceAsync(requirementId : UUID) : void
    +runReInferenceAsync(requirementId : UUID, changeInstructions : String) : void
    -runINF1(requirement : Requirement, context : String) : void
    -runINF3(requirement : Requirement, context : String) : void
    -runINF4(requirement : Requirement, context : String) : void
    -mergeContextWithAnswers(requirement : Requirement) : String
  }

  note bottom of AiInferencePcsfService
    Three sequential LLM passes, each merged onto the same
    Pcsf: INF-1 entities/relationships/business rules/status
    machines/access control/error codes; INF-3 screens/
    navigation; INF-4 API endpoints/apiConfig/databaseConfig/
    nonFunctionalRequirements/infrastructureConfig. INF-4
    prompts the model to adapt infrastructureConfig per
    project (deploymentTarget from the NFRs it just set;
    diagramRenderer defaults to NONE, only "kroki" if the
    app itself needs runtime diagram rendering as a feature).
    On any exception, pcsfStatus -> FAILED (recoverable via
    RequirementGenerationService.retryInference()).
  end note

  class PcsfValidationService {
    +validate(projectId : UUID) : PcsfValidateResponse
  }

  note bottom of PcsfValidationService
    Rules VR-01..VR-07c: project name/description required,
    >=1 actor, >=1 module, actor type required, use-case actor
    references must resolve, use-case preconditions/
    postconditions/main-scenario required. Sets pcsfStatus =
    VALIDATED on success (locks the PCSF for editing).
  end note

  class ProjectionBuilder {
  }

  note bottom of ProjectionBuilder
    Stub only (no fields, no methods) — will build downstream
    code-gen projection views of the PCSF in a later sprint.
  end note
}

' ============================================================
' util
' ============================================================
package "util" {
  class PcsfFieldWriter {
    +write(pcsf : Pcsf, path : String, value : String) : void
    +parseActors(answer : String) : List<PcsfActor>
    +parseModules(answer : String) : List<PcsfModule>
    +parseEntities(answer : String) : List<PcsfEntity>
    +parseRelationships(answer : String) : List<PcsfRelationship>
    +parseAccessControlRules(answer : String) : List<PcsfAccessControlRule>
    +parseErrorCodes(answer : String) : List<PcsfErrorCode>
    +parseScreens(answer : String) : List<PcsfScreen>
    +parseNavItems(answer : String) : List<PcsfNavItem>
  }

  note bottom of PcsfFieldWriter
    Routes a "dot path" (e.g. "actors",
    "conditionalFeatures.multiTenancy.required.value") to the
    right Pcsf field. parseActors/parseModules accept BOTH the
    ID-less pipe format the clarification question instructs
    ("Name | Type | Description") and the ID-included format
    used by the review screen's inline-edit feature
    ("id|Name|Type|Description") — the id-less case auto-mints
    a new ACT-NN/MOD-NN id.
  end note
}

' ============================================================
' domain (core entities + enums)
' ============================================================
package "domain" {
  enum PcsfStatus {
    DRAFT
    INFERRING
    UNDER_REVIEW
    VALIDATED
    APPROVED
    CHANGE_REQUESTED
    FAILED
  }

  enum QuestionType {
    TEXT
    TEXTAREA
    YES_NO
    SINGLE_SELECT
    MULTI_SELECT
  }

  class Requirement <<JPA Entity>> {
    -requirementId : UUID
    -projectId : UUID
    -projectTitle : String
    -projectDescription : String
    -projectContext : String
    -pcsfJson : String
    -pcsfStatus : PcsfStatus
    -pendingQuestionsCount : Integer
    -changeInstructions : String
    -createdAt : LocalDateTime
    -updatedAt : LocalDateTime
  }

  class ClarificationQuestion <<JPA Entity>> {
    -id : String
    -requirement : Requirement
    -inventoryRef : String
    -targetPath : String
    -priority : Integer
    -question : String
    -type : QuestionType
    -optionsJson : String
    -placeholder : String
    -answered : boolean
    -answer : String
  }
}

' ============================================================
' domain.pcsf (the PCSF aggregate — NOT a JPA structure,
' serialized as JSON into Requirement.pcsfJson)
' ============================================================
package "domain.pcsf" {
  class Pcsf {
    -project : PcsfProject
    -actors : List<PcsfActor>
    -publicAccess : PcsfPublicAccess
    -modules : List<PcsfModule>
    -conditionalFeatures : PcsfConditionalFeatures
    -entities : List<PcsfEntity>
    -relationships : List<PcsfRelationship>
    -businessRules : List<PcsfBusinessRule>
    -statusMachines : List<PcsfStatusMachine>
    -accessControlRules : List<PcsfAccessControlRule>
    -errorCodes : List<PcsfErrorCode>
    -endpoints : List<PcsfApiEndpoint>
    -nonFunctionalRequirements : PcsfNonFunctionalRequirements
    -userInterface : PcsfUserInterface
    -apiConfig : PcsfApiConfig
    -databaseConfig : PcsfDatabaseConfig
    -infrastructureConfig : PcsfInfrastructureConfig
    -validation : PcsfValidation
  }

  class "FieldValue<T>" as FieldValue {
    -value : T
    -source : FieldSource
    -status : FieldStatus
    -confidence : Double
    -riskLevel : RiskLevel
  }

  note top of FieldValue
    Generic provenance wrapper used by most PCSF leaf fields.
    Individual FieldValue<T> associations are omitted from the
    diagram below for readability — any field typed
    FieldValue<...> in the attribute list wraps that value with
    source/status/confidence/riskLevel.
  end note

  class PcsfProject {
    -name : FieldValue<String>
    -description : FieldValue<String>
    -organisationName : String
    -displayName : FieldValue<String>
    -derived : PcsfDerivedNames
  }

  class PcsfDerivedNames {
    -mavenArtifactId : String
    -javaRootPackage : String
    -angularProjectName : String
    -databaseName : String
    -databaseUser : String
  }

  class PcsfActor {
    -id : String
    -name : FieldValue<String>
    -type : FieldValue<String>
    -description : FieldValue<String>
    -springSecurityRole : FieldValue<String>
  }

  class PcsfModule {
    -id : String
    -name : FieldValue<String>
    -description : FieldValue<String>
    -crudOperations : FieldValue<List<String>>
    -javaPackageName : String
    -useCases : List<PcsfUseCase>
  }

  class PcsfUseCase {
    -id : String
    -name : FieldValue<String>
    -actorId : String
    -preconditions : FieldValue<String>
    -postconditions : FieldValue<String>
    -mainScenario : FieldValue<List<String>>
    -alternativeScenario : FieldValue<String>
  }

  class PcsfEntity {
    -id : String
    -name : FieldValue<String>
    -tableName : FieldValue<String>
    -primaryModuleId : String
    -auditFields : boolean
    -primaryKeyStrategy : String
    -softDelete : FieldValue<Boolean>
    -attributes : List<PcsfAttribute>
  }

  class PcsfAttribute {
    -id : String
    -name : FieldValue<String>
    -columnName : FieldValue<String>
    -javaType : FieldValue<String>
    -mysqlType : FieldValue<String>
    -constraints : PcsfConstraints
    -showInList : FieldValue<Boolean>
    -showInForm : FieldValue<Boolean>
  }

  class PcsfConstraints {
    -required : FieldValue<Boolean>
    -unique : FieldValue<Boolean>
    -minLength : FieldValue<Integer>
    -maxLength : FieldValue<Integer>
    -pattern : FieldValue<String>
  }

  class PcsfRelationship {
    -id : String
    -fromEntityId : String
    -toEntityId : String
    -cardinality : FieldValue<String>
    -optionality : FieldValue<String>
    -owningEntityId : String
    -joinColumnName : String
    -joinTableName : String
    -label : FieldValue<String>
  }

  class PcsfBusinessRule {
    -id : String
    -moduleId : String
    -useCaseId : String
    -affectedEntityId : String
    -description : FieldValue<String>
    -implementationHint : FieldValue<String>
  }

  class PcsfStatusMachine {
    -entityId : String
    -states : List<String>
    -initialState : String
    -transitions : List<StatusTransition>
  }

  class StatusTransition {
    -from : String
    -to : String
    -trigger : String
    -guard : String
    -action : String
  }

  class PcsfAccessControlRule {
    -id : String
    -moduleId : String
    -entityId : String
    -operation : String
    -allowedRoles : FieldValue<List<String>>
  }

  class PcsfErrorCode {
    -id : String
    -code : String
    -httpStatus : int
    -messageTemplate : String
    -exceptionClass : String
    -moduleId : String
  }

  class PcsfApiEndpoint {
    -id : String
    -moduleId : String
    -httpMethod : String
    -path : String
    -operationId : String
    -summary : String
    -requestBodyEntityId : String
    -responseEntityId : String
    -requiredRoles : List<String>
    -paginated : boolean
    -requiresAuth : boolean
  }

  class PcsfNonFunctionalRequirements {
    -concurrentUsers : FieldValue<Integer>
    -targetResponseTimeMs : FieldValue<Integer>
    -dataVolumeDescription : FieldValue<String>
    -availabilityTarget : FieldValue<String>
    -securityDepth : FieldValue<String>
    -locale : FieldValue<String>
  }

  class PcsfUserInterface {
    -colours : PcsfColours
    -screens : List<PcsfScreen>
    -navigation : List<PcsfNavItem>
  }

  class PcsfColours {
    -primary : String
    -secondary : String
    -accent : String
    -background : String
    -surface : String
    -error : String
    -warning : String
    -success : String
    -info : String
    -neutral : String
    -text : String
    -textOnPrimary : String
  }

  class PcsfScreen {
    -name : String
    -type : String
    -entityId : String
    -moduleId : String
    -routePath : String
    -requiredRoles : List<String>
    -tableColumns : List<TableColumn>
    -formFields : List<FormField>
  }

  class TableColumn {
    -attributeId : String
    -headerLabel : String
    -sortable : boolean
  }

  class FormField {
    -attributeId : String
    -label : String
    -controlType : String
  }

  class PcsfNavItem {
    -label : String
    -routePath : String
    -icon : String
    -visibleToRoles : List<String>
    -moduleId : String
  }

  class PcsfApiConfig {
    -versionPrefix : String
    -jwtAccessTokenValidityMs : long
    -jwtRefreshTokenValidityMs : long
    -rateLimitPerMinute : int
    -corsAllowedOriginsDev : String
    -defaultPageSize : int
    -maxPageSize : int
  }

  class PcsfDatabaseConfig {
    -name : String
    -user : String
    -charset : String
    -collation : String
  }

  class PcsfInfrastructureConfig {
    -backendPort : int
    -frontendPort : int
    -diagramRenderer : String
    -krokiInternalUrl : String
    -deploymentTarget : String
  }

  note bottom of PcsfInfrastructureConfig
    Defaults are neutral (diagramRenderer="NONE",
    krokiInternalUrl=null) rather than assuming every project
    needs Kroki — INF-4 fills these in per project (see
    AiInferencePcsfService note). Kroki is Astyann's own
    diagram-rendering dependency, not something every
    generated project needs.
  end note

  class PcsfConditionalFeatures {
    -fileUpload : ConditionalFlag
    -dataExport : ConditionalFlag
    -searchFilter : ConditionalFlag
    -multiTenancy : ConditionalFlag
  }

  class ConditionalFlag {
    -triggered : boolean
    -required : FieldValue<Boolean>
    -details : Map<String, Object>
  }

  class PcsfPublicAccess {
    -hasPublicActor : FieldValue<Boolean>
    -publicPaths : List<String>
  }

  class PcsfValidation {
    -completenessScore : double
    -generationReady : boolean
    -missingMandatoryItems : List<String>
    -pendingConditionalItems : List<String>
    -pendingInferredItems : List<String>
    -warnings : List<String>
    -errors : List<String>
  }
}

package "domain.pcsf.enums" {
  enum FieldSource {
    EXTRACTED
    QA
    AI_INFERRED
    DEFAULT
    HARDCODED
  }

  enum FieldStatus {
    CONFIRMED
    PENDING
    MISSING
  }

  enum RiskLevel {
    LOW
    MEDIUM
    HIGH
    NONE
  }
}

