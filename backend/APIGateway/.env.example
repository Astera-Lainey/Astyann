# ── JWT — must be IDENTICAL to the Auth Service ───────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=your_base64_encoded_secret_key_minimum_32_bytes

# ── Downstream service URLs (use Docker service names in Compose) ─────────
AUTH_SERVICE_URL=http://auth-service:8081
PROJECT_SERVICE_URL=http://project-service:8082
REQUIREMENT_SERVICE_URL=http://requirement-service:8083
UML_SERVICE_URL=http://uml-service:8084
DOCUMENT_SERVICE_URL=http://document-service:8085
CODE_GEN_SERVICE_URL=http://code-generation-service:8086
VERSION_SERVICE_URL=http://version-management-service:8087
DEPLOYMENT_SERVICE_URL=http://deployment-service:8088
AI_ORCHESTRATOR_SERVICE_URL=http://ai-orchestrator-service:8089

# ── Frontend CORS origin ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:4200
