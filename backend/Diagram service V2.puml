' ============================================================
' 5. UML SERVICE — Design Class Diagram
' ============================================================
@startuml UMLService_DesignClass
left to right direction
skinparam classAttributeIconSize 0

package "controller" {
  class UMLController {
    -umlService : IUMLService
    +generateDiagrams(projectId : UUID) : ResponseEntity<List<UMLDiagramDTO>>
    +getDiagrams(projectId : UUID) : ResponseEntity<List<UMLDiagramDTO>>
    +getDiagramById(diagramId : UUID) : ResponseEntity<UMLDiagramDTO>
    +approveDiagram(diagramId : UUID) : ResponseEntity<UMLDiagramDTO>
    +requestChanges(diagramId : UUID, dto : ChangeRequestDTO) : ResponseEntity<UMLDiagramDTO>
    +regenerateDiagram(diagramId : UUID) : ResponseEntity<UMLDiagramDTO>
    +renderDiagram(diagramId : UUID) : ResponseEntity<Resource>
  }
}

package "service" {
  interface IUMLService {
    +generateDiagrams(projectId : UUID) : List<UMLDiagramDTO>
    +getDiagrams(projectId : UUID) : List<UMLDiagramDTO>
    +getDiagramById(diagramId : UUID) : UMLDiagramDTO
    +approveDiagram(diagramId : UUID) : UMLDiagramDTO
    +requestChanges(diagramId : UUID, feedback : String) : UMLDiagramDTO
    +regenerateDiagram(diagramId : UUID) : UMLDiagramDTO
    +renderDiagram(diagramId : UUID) : byte[]
  }

  class UMLServiceImpl {
    -umlDiagramRepository : UMLDiagramRepository
    -aiOrchestratorClient : AIServiceClient
    -plantUMLClient : PlantUMLRenderingClient
    -versionClient : VersionServiceClient
    -storageService : StorageService
    +generateDiagrams(projectId : UUID) : List<UMLDiagramDTO>
    +getDiagrams(projectId : UUID) : List<UMLDiagramDTO>
    +getDiagramById(diagramId : UUID) : UMLDiagramDTO
    +approveDiagram(diagramId : UUID) : UMLDiagramDTO
    +requestChanges(diagramId : UUID, feedback : String) : UMLDiagramDTO
    +regenerateDiagram(diagramId : UUID) : UMLDiagramDTO
    +renderDiagram(diagramId : UUID) : byte[]
  }

  class UMLGeneratorEngine {
    -projectId : UUID
    +generateAll(context : String) : List<UMLDiagram>
    +generateByType(type : DiagramType, context : String) : UMLDiagram
    +render(sourceCode : String) : byte[]
  }
}

package "domain" {
  class UMLDiagram {
    -diagramId : UUID
    -projectId : UUID
    -type : DiagramType
    -sourceCode : String
    -generatedImageURL : String
    -generatedDate : LocalDateTime
    -feedback : String
  }

  enum DiagramType {
    USE_CASE
    BUSINESS_CLASS
    DESIGN_CLASS
    ACTIVITY
    BUSINESS_SEQUENCE
    DESIGN_SEQUENCE
    COMPONENT
    DEPLOYMENT
    PACKAGE
    ENTITY_RELATIONSHIP
  }

}

package "repository" {
  interface UMLDiagramRepository {
    +findByProjectId(projectId : UUID) : List<UMLDiagram>
    +findByDiagramId(diagramId : UUID) : Optional<UMLDiagram>
    +findByProjectIdAndType(projectId : UUID, type : DiagramType) : Optional<UMLDiagram>
    +save(diagram : UMLDiagram) : UMLDiagram
    +saveAll(diagrams : List<UMLDiagram>) : void
  }
}

package "dto" {
  class UMLDiagramDTO {
    +diagramId : UUID
    +type : DiagramType
    +generatedImageURL : String
    +generatedDate : LocalDateTime
  }

  class ChangeRequestDTO {
    +feedback : String
  }
}

package "client" {
  class AIServiceClient {
    +generatePlantUMLCode(type : DiagramType, context : String) : String
    +regenerateDiagram(diagramId : UUID, feedback : String) : String
  }

  class PlantUMLRenderingClient {
    +render(sourceCode : String) : byte[]
  }

  class VersionServiceClient {
    +createDiagramSnapshot(diagramId : UUID) : void
  }

  class StorageService {
    +saveDiagram(projectId : UUID, image : byte[]) : String
    +loadDiagram(path : String) : byte[]
  }
}

UMLController      ..>  IUMLService
UMLServiceImpl      ..|> IUMLService
UMLServiceImpl      ..>  UMLDiagramRepository
UMLServiceImpl      ..>  AIServiceClient
UMLServiceImpl      ..>  PlantUMLRenderingClient
UMLServiceImpl      ..>  VersionServiceClient
UMLServiceImpl      ..>  StorageService
UMLServiceImpl      ..>  UMLGeneratorEngine
UMLGeneratorEngine  ..>  UMLDiagram
UMLDiagramRepository ..> UMLDiagram
UMLDiagram          ..>  DiagramType

@enduml