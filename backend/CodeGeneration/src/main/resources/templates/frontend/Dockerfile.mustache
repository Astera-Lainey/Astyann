FROM node:20-alpine AS build
WORKDIR /app

# Installing an Angular toolchain pulls ~1000 packages, and npm's defaults (2 retries, short
# timeouts) give up quickly when a connection stalls — ECONNRESET part-way through is common
# inside Docker's NAT, behind a VPN, or on a proxy. These settings only affect retry and timeout
# behaviour; they never change which versions are resolved.
ENV NPM_CONFIG_FETCH_RETRIES=5 NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=20000 NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=120000 NPM_CONFIG_FETCH_TIMEOUT=600000

# The generated project ships a package.json but no lockfile, so `npm ci` alone would fail on a
# first build. The glob keeps a lockfile in play if one has been committed since (or captured by
# the validation step), in which case `npm ci` gives the reproducible install it is meant to.
COPY package.json package-lock.json* ./

# Three attempts, because npm's own per-request retries do not cover a transfer that is reset
# mid-install. The trailing call is unguarded on purpose: if the last attempt fails the RUN must
# fail too, rather than producing an image with no node_modules in it.
# Kept on one line on purpose: templates are checked out with CRLF endings on Windows, and a
# backslash continuation followed by a stray \r is a shell syntax error inside the container.
RUN npm_install() { if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi; }; npm_install || { echo "npm install failed, retrying in 5s"; sleep 5; npm_install; } || { echo "npm install failed, retrying in 20s"; sleep 20; npm_install; }

COPY . .
RUN npx ng build --configuration=production

FROM nginx:alpine
# angular.json is rendered from this same `project` object, so this path always matches its
# outputPath. The trailing /browser is the application builder's own layout — copying dist/
# itself would bury index.html two levels below nginx's root and every route would 404.
COPY --from=build /app/dist/{{project.angularProjectName}}/browser /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
# nginx.conf listens on 80; docker-compose maps the host's {{infra.frontendPort}} onto it.
EXPOSE 80