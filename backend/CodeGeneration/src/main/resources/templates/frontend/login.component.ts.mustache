import { ChangeDetectionStrategy, Component, inject, signal } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';
import { HttpClient } from '@angular/common/http';
import { Router } from '@angular/router';
// src/app/features/auth/login/ → src/environments/ is four levels up, not three.
import { environment } from '../../../../environments/environment';
import { AstCardComponent } from '../../../shared/ui/ast-card/ast-card.component';
import { AstInputComponent } from '../../../shared/ui/ast-input/ast-input.component';
import { AstButtonComponent } from '../../../shared/ui/ast-button/ast-button.component';

@Component({
  selector: 'app-login',
  standalone: true,
  imports: [CommonModule, ReactiveFormsModule, AstCardComponent, AstInputComponent, AstButtonComponent],
  templateUrl: './login.component.html',
  changeDetection: ChangeDetectionStrategy.OnPush
})
export class LoginComponent {

  private readonly fb = inject(FormBuilder);
  private readonly http = inject(HttpClient);
  private readonly router = inject(Router);

  readonly submitting = signal(false);
  readonly error = signal<string | null>(null);

  readonly form = this.fb.group({
    email: ['', [Validators.required, Validators.email]],
    password: ['', Validators.required]
  });

  onSubmit(): void {
    if (this.form.invalid) return;
    this.submitting.set(true);
    this.error.set(null);
    this.http.post<{ token: string }>(`${environment.apiBaseUrl}/auth/login`, this.form.value).subscribe({
      next: res => {
        localStorage.setItem('token', res.token);
        this.router.navigateByUrl('{{project.defaultRoute}}');
      },
      error: (err: any) => {
        this.error.set(err?.error?.message ?? 'Invalid credentials.');
        this.submitting.set(false);
      }
    });
  }
}
