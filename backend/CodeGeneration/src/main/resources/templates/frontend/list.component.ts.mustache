import { ChangeDetectionStrategy, Component, OnInit, inject, signal } from '@angular/core';
import { CommonModule } from '@angular/common';
import { Router, RouterLink } from '@angular/router';
import { {{module.serviceName}} } from '../../../core/services/{{module.serviceFileName}}.service';
import { {{module.entityClassName}} } from '../../../core/models/{{module.entityFileName}}.model';
import { AstCardComponent } from '../../../shared/ui/ast-card/ast-card.component';
import { AstTableComponent } from '../../../shared/ui/ast-table/ast-table.component';
import { AstButtonComponent } from '../../../shared/ui/ast-button/ast-button.component';
import { AstSpinnerComponent } from '../../../shared/ui/ast-spinner/ast-spinner.component';
import { AstEmptyStateComponent } from '../../../shared/ui/ast-empty-state/ast-empty-state.component';

@Component({
  selector: 'app-{{module.componentPrefix}}-list',
  standalone: true,
  imports: [CommonModule, RouterLink, AstCardComponent, AstTableComponent, AstButtonComponent, AstSpinnerComponent, AstEmptyStateComponent],
  templateUrl: './{{module.componentPrefix}}-list.component.html',
  changeDetection: ChangeDetectionStrategy.OnPush
})
export class {{module.entityClassName}}ListComponent implements OnInit {

  private readonly service = inject({{module.serviceName}});
  private readonly router = inject(Router);

  readonly items = signal<{{module.entityClassName}}[]>([]);
  readonly loading = signal(false);
  readonly error = signal<string | null>(null);
  readonly totalPages = signal(0);
  readonly currentPage = signal(0);

  readonly columns = [
{{#module.listColumns}}
    { label: '{{label}}', fieldName: '{{fieldName}}' },
{{/module.listColumns}}
  ];

  ngOnInit(): void {
    this.load();
  }

  load(page = 0): void {
    this.loading.set(true);
    this.error.set(null);
    this.service.getAll(page).subscribe({
      next: res => {
        this.items.set(res.content);
        this.totalPages.set(res.totalPages);
        this.currentPage.set(res.page);
        this.loading.set(false);
      },
      error: err => {
        this.error.set(err?.message ?? 'Failed to load {{module.entityInstanceName}} list.');
        this.loading.set(false);
      }
    });
  }

{{#module.hasDelete}}
  onDelete(id: string): void {
    if (!confirm('Delete this {{module.entityInstanceName}}?')) return;
    this.service.delete(id).subscribe({
      next: () => this.load(this.currentPage()),
      error: err => this.error.set(err?.message ?? 'Delete failed.')
    });
  }
{{/module.hasDelete}}
}
